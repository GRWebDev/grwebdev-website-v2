{
	"$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"includes": [
			"./astro.config.ts",
			"./playwright.config.ts",
			"./src/**/*.astro",
			"./src/**/*.css",
			"./src/**/*.md",
			"./src/**/*.ts",
			"./src/!.astro",
			"./scripts/**/*.ts",
			"./test/**/*.ts"
		],
		"ignoreUnknown": false
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"correctness": {
				// Biome 2.6.2 rejects valid grids: https://github.com/biomejs/biome/issues/12502
				// Re-enable after upgrading to a release containing https://github.com/biomejs/biome/pull/12508.
				"noInvalidGridAreas": "off"
			},
			"suspicious": {
				"noExplicitAny": "error"
			}
		}
	},
	"html": {
		"formatter": {
			"enabled": true,
			"indentScriptAndStyle": true
		},
		"experimentalFullSupportEnabled": true
	},
	"markdown": {
		"parser": {
			"frontmatter": true
		},
		"formatter": {
			"proseWrap": "preserve",
			"formatEmbeds": false
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["!.astro/**", "**/*.astro"],
			"linter": {
				"rules": {
					"style": {
						"useConst": "off",
						"useImportType": "off"
					},
					"correctness": {
						"noUnusedVariables": "off",
						"noUnusedImports": "off"
					}
				}
			}
		}
	]
}
