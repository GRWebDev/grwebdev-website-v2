---
import { Image } from "astro:assets";
import { getCollection, getEntry, render } from "astro:content";
import type { ImageMetadata } from "astro";
import boardPlaceholder from "../../assets/board/placeholder.svg";
import Layout from "../../layouts/Layout.astro";

const boardImages = import.meta.glob<{ default: ImageMetadata }>(
	"../../assets/board/*.{jpg,jpeg,png,webp,avif,svg}",
	{ eager: true },
);
const getBoardImage = (src?: string) =>
	src
		? (boardImages[`../../assets/board/${src}`]?.default ?? boardPlaceholder)
		: boardPlaceholder;

const { slug } = Astro.params;
const member = await getEntry("board", slug);
if (!member) {
	return Astro.redirect("/404", 404);
}
const { Content } = await render(member);
const memberTitlePrefix = member.data.title ? `${member.data.title}: ` : "";
const memberPageTitle = `${memberTitlePrefix}${member.data.name}`;
const memberImageTransitionStyle = `view-transition-name: ${member.data.slug}-image`;
const memberTitleTransitionStyle = `view-transition-name: ${member.data.slug}-title`;
export async function getStaticPaths() {
	const board = await getCollection("board");
	return board
		.filter((member) => member.data.active)
		.map((member) => ({ params: { slug: member.data.slug } }));
}
---

<style>
	:root {
		--direction: 1;
		@view-transition {
			navigation: auto;
			types: slider;
		}
	}
</style>
<Layout title={memberPageTitle}>
	<section class="grid">
		<div class="image-text">
			<Image
				src={getBoardImage(member.data.image.src)}
				alt={member.data.image.alt}
				width="300"
				height="375"
				class="cover"
				style={memberImageTransitionStyle}
			/>
			<div>
				<h1 class="board-title-stacked" style={memberTitleTransitionStyle}>
					<span class="board-title-role">{member.data.title}</span>
					<span class="board-title-name">{member.data.name}</span>
				</h1>
				<Content />
			</div>
		</div>
	</section>
</Layout>
