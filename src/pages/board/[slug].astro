---
import { Image } from "astro:assets";
import { getCollection, getEntry, render } from "astro:content";
import boardPlaceholder from "../../assets/board/placeholder.svg";
import Layout from "../../layouts/Layout.astro";

const { slug } = Astro.params;
const member = await getEntry("board", slug);
if (!member) {
	return Astro.redirect("/404", 404);
}
const { Content } = await render(member);
const hasBio = !!member.body;
const memberTitlePrefix = member.data.title ? `${member.data.title}: ` : "";
const memberPageTitle = `${memberTitlePrefix}${member.data.name}`;
const memberImageTransitionStyle = `view-transition-name: ${member.data.slug}-image`;
const memberTitleTransitionStyle = `view-transition-name: ${member.data.slug}-title`;
export async function getStaticPaths() {
	const board = await getCollection("board");
	return board
		.filter((member) => member.data.active)
		.map((member) => ({ params: { slug: member.data.slug } }));
}
---

<style>
	:root {
		--direction: 1;
		@view-transition {
			navigation: auto;
			types: slider;
		}
	}
</style>
<Layout title={memberPageTitle}>
	<section class="grid">
		<div class="container">
			<div class="image-text large">
				<Image
					src={member.data.image.src ?? boardPlaceholder}
					alt={member.data.image.src ? member.data.image.alt : ""}
					width="300"
					height="375"
					class="cover image"
					style={memberImageTransitionStyle}
				/>
				<h1
					class="board-title stacked title"
					style={memberTitleTransitionStyle}
				>
					{member.data.title && (
					<span class="board-title role">{member.data.title}</span>
				)}
					<span class="board-title name">{member.data.name}</span>
				</h1>
				<div class="body">
					{hasBio ?
					<Content /> : <p>Bio coming soon.</p>}
				</div>
			</div>
		</div>
	</section>
</Layout>
