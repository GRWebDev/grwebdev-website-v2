---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import boardPlaceholder from "../../assets/board/placeholder.svg";
import Layout from "../../layouts/Layout.astro";

const board = await getCollection("board");
const boardToUse = board
	.filter((member) => member.data.active)
	.toSorted((a, b) => {
		const aDate = a.data.joinDate;
		const bDate = b.data.joinDate;
		return aDate.valueOf() - bDate.valueOf();
	})
	.reduce(
		(a, c) => {
			switch (c.data.title) {
				case "President":
					a[0] = c;
					break;
				case "Vice President / Treasurer":
				case "Vice President":
					a[1] = c;
					break;
				case "Secretary":
					a[2] = c;
					break;
				// case "Treasurer":
				// 	a[2] = c;
				// 	break;
				default:
					a.push(c);
			}
			return a;
		},
		new Array(3).fill({}) as typeof board,
	)
	.filter((member) => !!member.id);
---

<style>
	:root {
		--direction: -1;
		@view-transition {
			navigation: auto;
			types: slider;
		}
	}

	img {
		object-fit: cover;
	}
</style>
<Layout title="Board">
	<section class="grid">
		<div>
			<h1>Board of Directors</h1>
		</div>
	</section>
	{boardToUse.map((member) => (
		<section class="grid">
			<div class="container">
				<div class="image-text">
					<a href={`${import.meta.env.BASE_URL}board/${member.data.slug}`}
					   class="image"
					   tabindex="-1">
						<Image
							src={member.data.image.src ?? boardPlaceholder}
							alt={member.data.image.src ? member.data.image.alt : `Place holder image for ${member.data.name}`}
							width="100"
							height="100"
							class="cover"
							style={{ viewTransitionName: `${member.data.slug}-image` }}
						/>
					</a>
					<a href={`${import.meta.env.BASE_URL}board/${member.data.slug}`}
					   class="title">
						<h2
							class="board-title stacked"
							style={`view-transition-name: ${member.data.slug}-title`}
						>
							{member.data.title && (
								<span class="board-title role">{member.data.title}</span>
							)}
							<span class="board-title name">{member.data.name}</span>
						</h2>
					</a>
					<p class="body">{member.data.shortDescription}</p>
				</div>
			</div>
		</section>
	))}
	{boardToUse.length === 0 && (
		<section class="grid">
			<div>
				<p>Board information is not available right now.</p>
			</div>
		</section>
	)}
</Layout>
