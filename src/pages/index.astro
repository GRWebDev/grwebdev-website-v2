---
import heroImage from "../assets/hero/hero.jpg";
import EventGrid from "../components/EventGrid.astro";
import Hero from "../components/Hero.astro";
import Layout from "../layouts/Layout.astro";
---

<style>
	@media (prefers-reduced-motion: no-preference) {
		@view-transition {
			navigation: auto;
		}
	}
</style>
<Layout title="Home">
	<Hero image={heroImage} headingId="hero-heading">
		<h1 id="hero-heading">For the community, by the community.</h1>
		<p>
			Grand Rapids Web Development Group is a group of tech enthusiasts in the
			Grand Rapids, MI area, offering meetups and more.
		</p>
	</Hero>
	<EventGrid />
</Layout>
