---
import EventGrid from "../components/EventGrid.astro";
import Home from "../components/Home.astro";
import Layout from "../layouts/Layout.astro";
---

<style>
	@media (prefers-reduced-motion: no-preference) {
		@view-transition {
			navigation: auto;
		}
	}
	.one-up-show {
		display: block;
		@container (width > 768px) {
			display: none;
		}
	}

	.two-up-show {
		display: none;
		@container (width > 768px) {
			display: block;
		}
		@container (width > 1200px) {
			display: none;
		}
	}

	.three-up-show {
		display: none;
		@container (width > 1200px) {
			display: block;
		}
		@container (width > 1600px) {
			display: none;
		}
	}
	.four-up-show {
		display: none;
		@container (width > 1200px) {
			display: none;
		}
		@container (width > 1600px) {
			display: block;
		}
	}
</style>
<Layout title="Home">
	<Home />
	<div class="one-up-show"><EventGrid gridSize={3} /></div>
	<div class="two-up-show"><EventGrid gridSize={4} old={1} /></div>
	<div class="three-up-show"><EventGrid gridSize={6} old={1} /></div>
	<div class="four-up-show"><EventGrid gridSize={8} old={2} /></div>
</Layout>
