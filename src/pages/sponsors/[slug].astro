---
import { Image } from "astro:assets";
import { getCollection, getEntry, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const { slug } = Astro.params;
const sponsor = await getEntry("sponsors", slug);
if (!sponsor) {
	return Astro.redirect("/404", 404);
}
const { Content } = await render(sponsor);
const sponsorImageTransitionStyle = `view-transition-name: ${sponsor.data.slug}-image`;
const sponsorTitleTransitionStyle = `view-transition-name: ${sponsor.data.slug}-title`;
export async function getStaticPaths() {
	const sponsors = await getCollection("sponsors");
	return sponsors
		.filter((sponsor) => sponsor.data.active)
		.map((sponsor) => ({ params: { slug: sponsor.data.slug } }));
}
---

<style>
	:root {
		--direction: 1;
		@view-transition {
			navigation: auto;
			types: slider;
		}
	}
	img {
		width: 16.67em;
		height: auto;
	}
</style>
<Layout title={sponsor.data.name}>
	<section class="grid">
		<div class="container">
			<div class="outdent image-text large">
				<Image
					class="contain image"
					src={sponsor.data.image.src}
					alt={sponsor.data.image.alt || `${sponsor.data.name} logo`}
					widths={[300]}
					style={sponsorImageTransitionStyle}
				/>
				<h1
					class="board-title stacked title"
					style={sponsorTitleTransitionStyle}
				>
					<span class="board-title name">{sponsor.data.name}</span>
				</h1>
				<div class="body">
					<Content />
				</div>
			</div>
		</div>
	</section>
</Layout>
