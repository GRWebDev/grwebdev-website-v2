---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404">
	<section class="grid">
		<div>
			<h1>Page not found</h1>
			<p>
				This page may have moved, or the link may be out of date. You can head
				back home or check the current board, sponsors, and event listings.
			</p>
			<p>
				<a href={import.meta.env.BASE_URL}>Go home</a>
			</p>
		</div>
	</section>
</Layout>
