---
import { Image } from "astro:assets";
import type { PrototypeEvent } from "./event-prototype-types.ts";

interface Props {
	events: PrototypeEvent[];
}

const { events } = Astro.props;
---

<section class="grid bulletin-prototype" aria-labelledby="prototype-b-heading">
	<div>
		<h2 id="prototype-b-heading">Upcoming events</h2>
		<p class="prototype-note">
			A text-first bulletin for people deciding where and when to show up.
		</p>
		<ol>
			{events.map((event) => (
				<li>
					<a href={event.href} target="_blank" rel="noopener noreferrer">
						<time datetime={event.dateTime} class="date">
							<span>{event.month}</span>
							<strong>{event.day}</strong>
						</time>
						<div class="details">
							<p class="format">{event.format}</p>
							<h3>{event.name}</h3>
							<p><strong>{event.time}</strong> at {event.venue}</p>
							<p class="address">{event.address}</p>
						</div>
						<Image src={event.image.src} alt="" width={120} height={150} quality="low" />
					</a>
				</li>
			))}
		</ol>
	</div>
</section>

<style>
	.prototype-note {
		max-inline-size: 65ch;
	}

	ol {
		list-style: none;
		margin-block-start: 1.5rem;
		padding: 0;
	}

	li {
		border-block-start: 1px solid var(--gray-300);
	}

	li:last-child {
		border-block-end: 1px solid var(--gray-300);
	}

	a {
		align-items: center;
		display: grid;
		gap: 1rem;
		grid-template-columns: 4rem minmax(0, 1fr) 5rem;
		padding-block: 0.9rem;
		text-decoration: none;
	}

	.date {
		align-items: center;
		border: 2px solid var(--primary-clr);
		display: flex;
		flex-direction: column;
		inline-size: 4rem;
		justify-content: center;
		min-block-size: 4rem;
	}

	.date span {
		font-size: 0.875em;
		font-weight: 700;
		text-transform: uppercase;
	}

	.date strong {
		font-size: 1.125rem;
		line-height: 1;
	}

	.details > * {
		margin-block-start: 0;
	}

	.format {
		color: var(--secondary-clr);
		font-size: 0.875em;
		font-weight: 700;
	}

	h3 {
		font-size: clamp(1rem, 2.5cqi, 1.5rem);
		line-height: 1.2;
	}

	.address {
		color: var(--gray-300);
		font-size: 0.875em;
	}

	img {
		aspect-ratio: 4 / 5;
		object-fit: cover;
	}

	a:hover h3,
	a:focus-visible h3 {
		text-decoration: underline;
		text-decoration-color: var(--secondary-clr);
		text-decoration-thickness: 0.12em;
		text-underline-offset: 0.2em;
	}

	@media (width < 34rem) {
		a {
			align-items: start;
			grid-template-columns: 4rem minmax(0, 1fr);
		}

		img {
			display: none;
		}
	}
</style>
