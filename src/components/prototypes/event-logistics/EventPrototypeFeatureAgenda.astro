---
import { Image } from "astro:assets";
import type { PrototypeEvent } from "./event-prototype-types.ts";

interface Props {
	events: PrototypeEvent[];
}

const { events } = Astro.props;
const [featured, ...agenda] = events;
---

<section
	class="grid feature-agenda-prototype"
	aria-labelledby="prototype-c-heading"
>
	<div>
		<h2 id="prototype-c-heading">Next up</h2>
		<p class="prototype-note">
			One decisive flyer opens the schedule. The rest reads like an agenda.
		</p>
		{featured && (
			<a class="featured" href={featured.href} target="_blank" rel="noopener noreferrer">
				<Image
					src={featured.image.src}
					alt=""
					widths={[360, 720]}
					sizes="(min-width: 700px) 45vw, 100vw"
					quality="low"
				/>
				<div class="featured-copy">
					<p class="next-date"><time datetime={featured.dateTime}>{featured.dateLabel}</time></p>
					<h3>{featured.name}</h3>
					<p class="big-detail">{featured.time}</p>
					<p>{featured.venue} · {featured.format}</p>
					<p class="address">{featured.address}</p>
					<span class="meetup-link">Open the Meetup listing →</span>
				</div>
			</a>
		)}
		<h3 class="agenda-heading">Later</h3>
		<ol class="agenda">
			{agenda.map((event) => (
				<li>
					<a href={event.href} target="_blank" rel="noopener noreferrer">
						<time datetime={event.dateTime}>{event.month} {event.day}</time>
						<span class="event-name">{event.name}</span>
						<span>{event.time}</span>
						<span>{event.venue}</span>
						<span class="format">{event.format}</span>
					</a>
				</li>
			))}
		</ol>
	</div>
</section>

<style>
	.prototype-note {
		max-inline-size: 65ch;
	}

	.featured {
		background: var(--primary-clr);
		color: var(--tertiary-clr);
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.8fr);
		margin-block-start: 1.5rem;
		text-decoration: none;
	}

	.featured img {
		block-size: 100%;
		object-fit: cover;
	}

	.featured-copy {
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: clamp(1.25rem, 4cqi, 3rem);
	}

	.featured-copy > * {
		margin-block-start: 0;
	}

	.next-date,
	.format {
		color: var(--secondary-clr);
		font-weight: 700;
	}

	.format {
		white-space: nowrap;
	}

	.featured h3 {
		font-size: clamp(1.75rem, 4cqi, 3.5rem);
		line-height: 1.05;
		margin-block: 0.35em;
	}

	.big-detail {
		font-size: 1.125rem;
		font-weight: 700;
	}

	.address {
		color: var(--gray-800);
	}

	.meetup-link {
		font-weight: 700;
		margin-block-start: 1.5rem;
	}

	.featured:hover .meetup-link,
	.featured:focus-visible .meetup-link {
		text-decoration: underline;
		text-decoration-color: var(--secondary-clr);
		text-decoration-thickness: 0.12em;
		text-underline-offset: 0.2em;
	}

	.agenda-heading {
		font-size: 1.125rem;
		margin-block-start: 2rem;
	}

	.agenda {
		list-style: none;
		padding: 0;
	}

	.agenda li {
		border-block-start: 1px solid var(--gray-300);
	}

	.agenda li:last-child {
		border-block-end: 1px solid var(--gray-300);
	}

	.agenda a {
		align-items: baseline;
		display: grid;
		gap: 0.75rem;
		grid-template-columns: 5rem minmax(12rem, 1.8fr) 7rem minmax(8rem, 1fr) 5rem;
		padding-block: 0.85rem;
		text-decoration: none;
	}

	.event-name {
		font-weight: 700;
	}

	.agenda a:hover .event-name,
	.agenda a:focus-visible .event-name {
		text-decoration: underline;
		text-decoration-color: var(--secondary-clr);
		text-decoration-thickness: 0.12em;
		text-underline-offset: 0.2em;
	}

	@media (width < 48rem) {
		.featured {
			grid-template-columns: 1fr;
		}

		.agenda a {
			gap: 0.25rem 0.75rem;
			grid-template-columns: 4.5rem minmax(0, 1fr);
		}

		.agenda a > :not(time, .event-name) {
			grid-column: 2;
		}
	}
</style>
