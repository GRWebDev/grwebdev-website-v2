---
// PROTOTYPE: Three event-logistics variants, switchable via ?variant=, on the existing home route.
import type { CollectionEntry } from "astro:content";
import { formatEventDate } from "../../../utils/event-date.ts";
import PrototypeSwitcher from "../PrototypeSwitcher.astro";
import EventPrototypeBulletin from "./EventPrototypeBulletin.astro";
import EventPrototypeFeatureAgenda from "./EventPrototypeFeatureAgenda.astro";
import EventPrototypePosterGrid from "./EventPrototypePosterGrid.astro";

interface Props {
	events: CollectionEntry<"events">[];
}

const { events } = Astro.props;
const variants = [
	{ key: "A", name: "Poster captions" },
	{ key: "B", name: "Bulletin list" },
	{ key: "C", name: "Feature + agenda" },
];
const monthFormatter = new Intl.DateTimeFormat("en-US", {
	month: "short",
	timeZone: "UTC",
});
const dayFormatter = new Intl.DateTimeFormat("en-US", {
	day: "numeric",
	timeZone: "UTC",
});
const detailedEvents = events.map((event, index) => {
	const isCoffee = event.data.name.includes("Coffee with Creators");
	const isOnline = event.data.name.includes("Code + Commiserate");
	return {
		address: isCoffee
			? "77 Monroe Center St NW, Suite 600"
			: isOnline
				? "Meetup video room"
				: "See the Meetup listing",
		dateLabel: formatEventDate({ date: event.data.date }),
		dateTime: event.data.date.toISOString().slice(0, 10),
		day: dayFormatter.format(event.data.date),
		format: isCoffee ? "In person" : isOnline ? "Online" : "Meetup listing",
		href: event.data.url,
		id: `prototype-event-${index}`,
		image: index % 2 === 0 ? event.data.images.light : event.data.images.dark,
		month: monthFormatter.format(event.data.date),
		name: event.data.name,
		time: isCoffee ? "9:00 AM ET" : isOnline ? "8:00 AM ET" : "See Meetup",
		venue: isCoffee
			? "The Factory"
			: isOnline
				? "Online event"
				: "Location varies",
	};
});
---

<div data-prototype-variant="A">
	<EventPrototypePosterGrid events={detailedEvents} />
</div>
<div data-prototype-variant="B" hidden>
	<EventPrototypeBulletin events={detailedEvents} />
</div>
<div data-prototype-variant="C" hidden>
	<EventPrototypeFeatureAgenda events={detailedEvents} />
</div>
<PrototypeSwitcher current="A" variants={variants} />

<script>
	const requestedVariant = new URL(window.location.href).searchParams
		.get("variant")
		?.toUpperCase();
	const activeVariant = ["A", "B", "C"].includes(requestedVariant ?? "")
		? requestedVariant
		: "A";

	for (const panel of document.querySelectorAll<HTMLElement>(
		"[data-prototype-variant]",
	)) {
		panel.hidden = panel.dataset.prototypeVariant !== activeVariant;
	}
</script>
