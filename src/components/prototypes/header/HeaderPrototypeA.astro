---
import Logo from "../../../assets/grwebdev.svg";

const donateUrl = "https://givebutter.com/gRBJRg";
const baseUrl = import.meta.env.BASE_URL;
---

<header class="prototype-header prototype-header--a">
	<nav class="grid" aria-label="Primary navigation — prototype A">
		<div class="header-bar">
			<a class="brand" href={baseUrl} aria-label="GRWebDev home">
				<Logo />
			</a>

			<ul class="desktop-links">
				<li><a href={`${baseUrl}board`}>Board</a></li>
				<li><a href={`${baseUrl}sponsors`}>Sponsors</a></li>
				<li><a href={`${baseUrl}about`}>About</a></li>
			</ul>

			<givebutter-widget id="gRBJRg" class="donation-widget">
				<a
					class="donate-action"
					href={donateUrl}
					target="_blank"
					rel="noopener noreferrer"
				>
					Donate
				</a>
			</givebutter-widget>

			<details class="mobile-menu">
				<summary aria-label="Toggle navigation menu">
					<span class="menu-mark" aria-hidden="true"></span>
				</summary>
				<ul>
					<li><a href={`${baseUrl}board`}>Board</a></li>
					<li><a href={`${baseUrl}sponsors`}>Sponsors</a></li>
					<li><a href={`${baseUrl}about`}>About</a></li>
				</ul>
			</details>
		</div>
	</nav>
</header>

<style>
	.prototype-header {
		background: var(--tertiary-clr);
		border-block-end: 1px solid var(--gray-900);
		box-shadow: 0 -0.5em 0.5em 0.5em var(--gray-700);
		color: var(--primary-clr);
		position: sticky;
		top: 0;
		z-index: 4;
	}

	.header-bar {
		align-items: center;
		display: flex;
		gap: clamp(0.5rem, 2cqi, 1.5rem);
		min-block-size: 4.25rem;
		position: relative;
	}

	.brand {
		align-items: center;
		display: inline-flex;
		margin-inline-end: auto;
		min-block-size: 44px;
	}

	.brand svg {
		inline-size: clamp(4.7rem, 15cqi, 6.4rem);
	}

	.desktop-links,
	.mobile-menu ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.desktop-links {
		display: none;
	}

	.donation-widget {
		display: inline-flex;
	}

	.donate-action,
	summary {
		align-items: center;
		display: inline-flex;
		font-weight: 700;
		justify-content: center;
		min-block-size: 44px;
	}

	.donate-action {
		background: var(--secondary-clr);
		color: var(--tertiary-clr);
		padding-inline: clamp(0.75rem, 3cqi, 1.15rem);
		text-decoration: none;
	}

	.donate-action:hover,
	.donate-action:focus-visible {
		text-decoration: underline;
		text-decoration-thickness: 0.12em;
		text-underline-offset: 0.24em;
	}

	.mobile-menu summary {
		block-size: 3.5rem;
		box-sizing: border-box;
		cursor: pointer;
		inline-size: 2.75rem;
		list-style: none;
		padding-inline: 0.75rem;
	}

	.mobile-menu summary::-webkit-details-marker {
		display: none;
	}

	.mobile-menu summary:focus-visible {
		outline: 2px solid var(--secondary-clr);
		outline-offset: 0.2em;
	}

	.menu-mark,
	.menu-mark::before,
	.menu-mark::after {
		background: currentColor;
		block-size: 2px;
		display: block;
		inline-size: 1.25rem;
		position: relative;
		transition: transform 160ms ease-out;
	}

	.menu-mark::before,
	.menu-mark::after {
		content: "";
		inset-inline-start: 0;
		position: absolute;
	}

	.menu-mark::before {
		inset-block-start: -0.4rem;
	}

	.menu-mark::after {
		inset-block-start: 0.4rem;
	}

	.mobile-menu[open] .menu-mark {
		background: transparent;
	}

	.mobile-menu[open] .menu-mark::before {
		inset-block-start: 0;
		transform: rotate(45deg);
	}

	.mobile-menu[open] .menu-mark::after {
		inset-block-start: 0;
		transform: rotate(-45deg);
	}

	.mobile-menu ul {
		align-items: stretch;
		background: var(--tertiary-clr);
		box-shadow: 0 0.4rem 0.45rem oklch(from var(--gray-100) l c h / 0.2);
		display: grid;
		gap: 0;
		grid-auto-rows: 2.75rem;
		inset-block-start: 100%;
		inset-inline: -0.5rem;
		position: absolute;
	}

	.mobile-menu li {
		block-size: 2.75rem;
	}

	.mobile-menu li + li {
		position: static;
	}

	.mobile-menu li + li::before {
		content: none;
	}

	.mobile-menu li a {
		align-items: center;
		block-size: 2.75rem;
		display: flex;
		font-size: 1.125rem;
		min-block-size: 2.75rem;
		padding-inline: 1rem;
	}

	@media (width >= 43rem) {
		.header-bar {
			min-block-size: 5rem;
		}

		.desktop-links {
			align-items: center;
			display: flex;
			gap: clamp(1rem, 2.5cqi, 2rem);
		}

		.prototype-header .desktop-links a {
			align-items: center;
			display: inline-flex;
			min-block-size: 44px;
		}

		.mobile-menu {
			display: none;
		}
	}
</style>
