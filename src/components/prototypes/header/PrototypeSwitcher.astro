{import.meta.env.DEV && (
		<aside
			class="prototype-switcher"
			data-prototype-switcher
			aria-label="Header prototype variants"
		>
			<a
				href="?variant=B"
				data-variant-link
				aria-label="Show the previous option"
			>
				←
			</a>
			<p aria-live="polite">
				<span data-variant-key>Option A</span>
				<strong data-variant-name>Priority row</strong>
			</p>
			<a
				href="?variant=B"
				data-variant-link
				aria-label="Show the next option"
			>
				→
			</a>
		</aside>
	)}

<script>
	const names = {
		A: "Priority row",
		B: "Community support rail",
	};
	const switcher = document.querySelector<HTMLElement>(
		"[data-prototype-switcher]",
	);
	const requestedVariant = new URL(window.location.href).searchParams
		.get("variant")
		?.toUpperCase();
	const current = requestedVariant === "B" ? "B" : "A";
	const other = current === "A" ? "B" : "A";

	document.documentElement.dataset.headerVariant = current;
	document.title = `Header option ${current} | GRWebDev prototype`;
	document
		.querySelectorAll<HTMLElement>("[data-current-variant]")
		.forEach((label) => {
			label.textContent = current;
		});

	if (switcher) {
		const variantKey =
			switcher.querySelector<HTMLElement>("[data-variant-key]");
		const variantName = switcher.querySelector<HTMLElement>(
			"[data-variant-name]",
		);
		if (variantKey) variantKey.textContent = `Option ${current}`;
		if (variantName) variantName.textContent = names[current];
		switcher
			.querySelectorAll<HTMLAnchorElement>("[data-variant-link]")
			.forEach((link) => {
				link.href = `?variant=${other}`;
			});
	}

	document.addEventListener("keydown", (event) => {
		if (
			!switcher ||
			(event.key !== "ArrowLeft" && event.key !== "ArrowRight")
		) {
			return;
		}

		const target = event.target;
		if (
			target instanceof HTMLInputElement ||
			target instanceof HTMLTextAreaElement ||
			target instanceof HTMLSelectElement ||
			(target instanceof HTMLElement && target.isContentEditable)
		) {
			return;
		}

		const link = switcher.querySelector<HTMLAnchorElement>(
			"[data-variant-link]",
		);
		if (link) {
			event.preventDefault();
			window.location.assign(link.href);
		}
	});
</script>

<style>
	.prototype-switcher {
		align-items: center;
		background: var(--gray-100);
		box-shadow: 0 0.25rem 0.5rem oklch(from var(--gray-050) l c h / 0.38);
		color: var(--gray-1000);
		display: grid;
		gap: 0.75rem;
		grid-template-columns: 44px minmax(10.5rem, auto) 44px;
		inset-block-end: 1rem;
		inset-inline-start: 50%;
		padding: 0.35rem;
		position: fixed;
		transform: translateX(-50%);
		z-index: 20;
	}

	.prototype-switcher a {
		align-items: center;
		background: var(--gray-1000);
		color: var(--gray-100);
		display: inline-flex;
		font-size: 1.25rem;
		justify-content: center;
		min-block-size: 44px;
		text-decoration: none;
	}

	.prototype-switcher a:hover,
	.prototype-switcher a:focus-visible {
		background: var(--secondary-clr);
		color: var(--tertiary-clr);
	}

	.prototype-switcher p {
		display: grid;
		font-size: 0.78rem;
		line-height: 1.25;
		margin: 0;
		text-align: center;
	}

	.prototype-switcher strong {
		font-size: 0.92rem;
	}
</style>
