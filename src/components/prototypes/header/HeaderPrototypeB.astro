---
import Logo from "../../../assets/grwebdev.svg";

const donateUrl = "https://givebutter.com/gRBJRg";
const baseUrl = import.meta.env.BASE_URL;
---

<header class="prototype-header prototype-header--b">
	<div class="support-band">
		<span>Help keep the community open</span>
		<givebutter-widget id="gRBJRg">
			<a href={donateUrl} target="_blank" rel="noopener noreferrer">
				Donate to GRWebDev
			</a>
		</givebutter-widget>
	</div>

	<nav class="grid" aria-label="Primary navigation — prototype B">
		<div class="navigation-board">
			<a class="brand" href={baseUrl} aria-label="GRWebDev home">
				<Logo />
			</a>

			<ul class="desktop-links">
				<li><a href={`${baseUrl}board`}>Board</a></li>
				<li><a href={`${baseUrl}sponsors`}>Sponsors</a></li>
				<li><a href={`${baseUrl}about`}>About</a></li>
			</ul>

			<details class="mobile-directory">
				<summary>
					<span>Explore</span>
					<span class="toggle-mark" aria-hidden="true">+</span>
				</summary>
				<ul>
					<li>
						<a href={`${baseUrl}board`}><span>01</span> Board</a>
					</li>
					<li>
						<a href={`${baseUrl}sponsors`}><span>02</span> Sponsors</a>
					</li>
					<li>
						<a href={`${baseUrl}about`}><span>03</span> About</a>
					</li>
				</ul>
			</details>
		</div>
	</nav>
</header>

<style>
	.prototype-header {
		background: var(--tertiary-clr);
		border-block-end: 1px solid var(--gray-900);
		box-shadow: 0 -0.5em 0.5em 0.5em var(--gray-700);
		color: var(--primary-clr);
		position: sticky;
		top: 0;
		z-index: 4;
	}

	.support-band {
		align-items: center;
		background: var(--gray-100);
		color: var(--tertiary-clr);
		display: flex;
		font-size: clamp(0.8rem, 2.8cqi, 0.95rem);
		gap: clamp(0.75rem, 3cqi, 1.5rem);
		justify-content: space-between;
		min-block-size: 4.5rem;
		padding-inline: max(0.75rem, calc((100cqi - var(--main-max-width)) / 2));
	}

	.navigation-board {
		align-items: start;
		display: grid;
		grid-template-columns: auto minmax(8.5rem, 1fr);
		min-block-size: 4.25rem;
	}

	.brand {
		align-items: center;
		display: inline-flex;
		min-block-size: 4.25rem;
	}

	.brand svg {
		inline-size: clamp(4.7rem, 15cqi, 6.4rem);
	}

	.desktop-links,
	.mobile-directory ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.desktop-links {
		display: none;
	}

	.mobile-directory {
		justify-self: stretch;
		margin-inline-start: clamp(1rem, 5cqi, 2.5rem);
	}

	.mobile-directory summary {
		align-items: center;
		cursor: pointer;
		display: flex;
		font-weight: 700;
		justify-content: space-between;
		list-style: none;
		min-block-size: 4.25rem;
		padding-inline: 0.25rem 0;
	}

	.mobile-directory summary::-webkit-details-marker {
		display: none;
	}

	.mobile-directory summary:focus-visible {
		outline: 2px solid var(--secondary-clr);
		outline-offset: 0.2em;
	}

	.toggle-mark {
		color: var(--secondary-clr);
		font-size: 1.75rem;
		font-weight: 300;
		line-height: 1;
		transition: transform 180ms ease-out;
	}

	.mobile-directory[open] .toggle-mark {
		transform: rotate(45deg);
	}

	.mobile-directory ul {
		border-block-start: 1px solid var(--gray-800);
		display: grid;
		padding-block-end: 0.7rem;
	}

	.mobile-directory li + li {
		border-block-start: 1px solid var(--gray-800);
		position: static;
	}

	.mobile-directory li + li::before {
		content: none;
	}

	.mobile-directory a {
		align-items: center;
		display: grid;
		gap: 0.75rem;
		grid-template-columns: 2ch 1fr;
		min-block-size: 2.9rem;
	}

	.mobile-directory a span {
		color: var(--secondary-clr);
		font-size: 0.72em;
		font-weight: 700;
	}

	@media (width >= 43rem) {
		.support-band {
			justify-content: center;
		}

		.navigation-board {
			align-items: center;
			display: flex;
			min-block-size: 4.75rem;
		}

		.brand {
			margin-inline-end: auto;
			min-block-size: 4.75rem;
		}

		.desktop-links {
			align-items: center;
			display: flex;
			gap: 0;
		}

		.desktop-links li + li::before {
			border: 0;
			bottom: auto;
			color: var(--secondary-clr);
			content: "/";
			height: auto;
			left: auto;
			margin-inline: clamp(0.8rem, 2cqi, 1.5rem);
			position: static;
			top: auto;
		}

		.desktop-links a {
			align-items: center;
			display: inline-flex;
			min-block-size: 44px;
		}

		.mobile-directory {
			display: none;
		}
	}
</style>
