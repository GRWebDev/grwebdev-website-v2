---
interface Variant {
	key: string;
	name: string;
}

interface Props {
	current: string;
	variants: Variant[];
}

const { current, variants } = Astro.props;
const currentIndex = Math.max(
	0,
	variants.findIndex(({ key }) => key === current),
);
const previous =
	variants[(currentIndex - 1 + variants.length) % variants.length];
const next = variants[(currentIndex + 1) % variants.length];
const hrefFor = (key: string) => {
	const url = new URL(Astro.url);
	url.searchParams.set("variant", key);
	return `${url.pathname}${url.search}`;
};
---

<aside
	class="prototype-switcher"
	aria-label="Event logistics prototype variants"
	data-prototype-variants={JSON.stringify(variants)}
>
	<a
		href={hrefFor(previous.key)}
		data-prototype-previous
		aria-label={`Previous variant: ${previous.name}`}
		>←</a
	>
	<p>
		<strong data-prototype-current-key>{variants[currentIndex].key}</strong>
		— <span data-prototype-current-name>{variants[currentIndex].name}</span>
	</p>
	<a
		href={hrefFor(next.key)}
		data-prototype-next
		aria-label={`Next variant: ${next.name}`}
		>→</a
	>
</aside>

<script>
	interface PrototypeVariant {
		key: string;
		name: string;
	}

	const switcher = document.querySelector<HTMLElement>(".prototype-switcher");
	if (switcher) {
		const variants = JSON.parse(
			switcher.dataset.prototypeVariants ?? "[]",
		) as PrototypeVariant[];
		const requestedVariant = new URL(window.location.href).searchParams
			.get("variant")
			?.toUpperCase();
		const currentIndex = Math.max(
			0,
			variants.findIndex(({ key }) => key === requestedVariant),
		);
		const previous =
			variants[(currentIndex - 1 + variants.length) % variants.length];
		const current = variants[currentIndex];
		const next = variants[(currentIndex + 1) % variants.length];
		const hrefFor = (key: string) => {
			const url = new URL(window.location.href);
			url.searchParams.set("variant", key);
			return `${url.pathname}${url.search}${url.hash}`;
		};
		const previousLink = switcher.querySelector<HTMLAnchorElement>(
			"[data-prototype-previous]",
		);
		const nextLink = switcher.querySelector<HTMLAnchorElement>(
			"[data-prototype-next]",
		);
		const currentKey = switcher.querySelector<HTMLElement>(
			"[data-prototype-current-key]",
		);
		const currentName = switcher.querySelector<HTMLElement>(
			"[data-prototype-current-name]",
		);

		if (previousLink) {
			previousLink.href = hrefFor(previous.key);
			previousLink.ariaLabel = `Previous variant: ${previous.name}`;
		}
		if (nextLink) {
			nextLink.href = hrefFor(next.key);
			nextLink.ariaLabel = `Next variant: ${next.name}`;
		}
		if (currentKey) currentKey.textContent = current.key;
		if (currentName) currentName.textContent = current.name;

		document.addEventListener("keydown", (event) => {
			const target = event.target as HTMLElement | null;
			if (
				target?.matches("input, textarea, [contenteditable]") ||
				(event.key !== "ArrowLeft" && event.key !== "ArrowRight")
			) {
				return;
			}

			const selector =
				event.key === "ArrowLeft"
					? "[data-prototype-previous]"
					: "[data-prototype-next]";
			const link = switcher.querySelector<HTMLAnchorElement>(selector);
			if (link) window.location.assign(link.href);
		});
	}
</script>

<style>
	.prototype-switcher {
		align-items: center;
		background: var(--primary-clr);
		border: 2px solid var(--tertiary-clr);
		border-radius: 0;
		color: var(--tertiary-clr);
		display: flex;
		gap: 0.5rem;
		inset-block-end: 1rem;
		inset-inline-start: 50%;
		max-inline-size: calc(100vw - 2rem);
		padding: 0.25rem;
		position: fixed;
		transform: translateX(-50%);
		z-index: 50;
	}

	.prototype-switcher p {
		font-size: 0.875em;
		margin: 0;
		min-inline-size: min(48vw, 13rem);
		text-align: center;
		white-space: nowrap;
	}

	.prototype-switcher a {
		align-items: center;
		border-radius: 0;
		display: inline-flex;
		font-size: 1.125rem;
		font-weight: 700;
		inline-size: 44px;
		justify-content: center;
		min-block-size: 44px;
		text-decoration: none;
	}

	.prototype-switcher a:hover,
	.prototype-switcher a:focus-visible {
		background: var(--tertiary-clr);
		color: var(--primary-clr);
		text-decoration: none;
	}
</style>
