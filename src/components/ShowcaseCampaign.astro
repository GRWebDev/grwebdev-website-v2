---
import ShowcaseDialog from "./ShowcaseDialog.astro";
import ShowcaseInvitation from "./ShowcaseInvitation.astro";

// Static rendering: both invitation surfaces disappear only after a new build.
const acceptingSubmissions = Date.now() < Date.parse("2026-11-14T05:00:00Z");
---

{acceptingSubmissions && (
	<>
		<section class="grid showcase" aria-labelledby="showcase-heading">
			<div><ShowcaseInvitation headingId="showcase-heading" /></div>
		</section>
		<ShowcaseDialog />
	</>
)}

<style>
	.showcase {
		margin-block-start: 3cap;
	}
	.showcase :global(.showcase-copy) {
		max-inline-size: none;
	}
	@media (min-width: 800px) {
		.showcase :global(.showcase-copy) {
			display: grid;
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
			column-gap: 1.25rem;
			align-items: start;
		}
		.showcase :global(h2) {
			grid-column: 1;
			grid-row: 1 / 4;
		}
		.showcase :global(p) {
			grid-column: 2;
		}
		.showcase :global(p:first-of-type) {
			margin-block-start: 0;
		}
		.showcase :global(a) {
			grid-column: 2;
			justify-self: start;
		}
	}
</style>
