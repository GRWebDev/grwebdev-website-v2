---
import facebook from "../assets/social/facebook-logo.svg?url";
import github from "../assets/social/github-logo.svg?url";
import instagram from "../assets/social/instagram-logo.svg?url";
import linkedin from "../assets/social/linkedin-logo.svg?url";
import meetup from "../assets/social/meetup.svg?url";
import x from "../assets/social/x-logo.svg?url";
---

<footer>
	<section class="grid">
		<div>
			<ul class="social-media">
				<li>
					<a
						href="https://www.meetup.com/grwebdev/"
						title="GrWebDev on Meetup"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="GrWebDev on Meetup"
					>
						<img
							src={meetup}
							alt=""
							width="50"
							height="50"
							loading="lazy"
							decoding="async"
						>
					</a>
				</li>
				<li>
					<a
						href="https://www.linkedin.com/company/grwebdev/"
						title="GrWebDev on LinkedIn"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="GrWebDev on LinkedIn"
					>
						<img
							src={linkedin}
							alt=""
							width="50"
							height="50"
							loading="lazy"
							decoding="async"
						>
					</a>
				</li>
				<li>
					<a
						href="https://www.facebook.com/GRWebDev"
						title="GrWebDev on Facebook"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="GrWebDev on Facebook"
					>
						<img
							src={facebook}
							alt=""
							width="50"
							height="50"
							loading="lazy"
							decoding="async"
						>
					</a>
				</li>
				<li>
					<a
						href="https://github.com/GRWebDev/"
						title="GrWebDev on GitHub"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="GrWebDev on GitHub"
					>
						<img
							src={github}
							alt=""
							width="50"
							height="50"
							loading="lazy"
							decoding="async"
						>
					</a>
				</li>
				<li>
					<a
						href="https://www.instagram.com/grwebdevorg/"
						title="GrWebDev on Instagram"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="GrWebDev on Instagram"
					>
						<img
							src={instagram}
							alt=""
							width="50"
							height="50"
							loading="lazy"
							decoding="async"
						>
					</a>
				</li>
				<li>
					<a
						href="https://x.com/grwebdev"
						title="GrWebDev on X"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="GrWebDev on X"
					>
						<img
							src={x}
							alt=""
							width="50"
							height="50"
							loading="lazy"
							decoding="async"
						>
					</a>
				</li>
			</ul>
			<h2 class="address--header">Contact Us:</h2>
			<p class="address">
				<small>
					Grand Rapids Web Development Group
					<br>℅ Start Garden
					<br>2 Fulton Street W<br>
					Grand Rapids, MI 49503
					<br>
				</small>
			</p>
			<p class="ein">
				<small>A 501(c)(3) Organization. EIN: 92-0733019</small>
			</p>
			<p class="copy"><small>&copy; GRWebDev</small></p>
			<a
				href="https://app.candid.org/profile/14664734/grand-rapids-web-development-group-92-0733019"
				target="_blank"
				rel="noopener noreferrer"
				class="seal"
			>
				<img
					src="https://widgets.guidestar.org/prod/v1/pdp/transparency-seal/14664734/svg"
					alt="Bronze Transparency Seal - Candid"
					width="108"
					height="108"
					loading="lazy"
					decoding="async"
				>
			</a>
		</div>
	</section>
</footer>
