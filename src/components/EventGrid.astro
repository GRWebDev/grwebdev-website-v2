---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import ExternalLink from "../assets/icons/square-arrow-out-up-right.svg";
import {
	formatEventDate,
	formatEventTime,
	isEventUpcoming,
} from "../utils/event-date.ts";

interface Props {
	gridSize: number;
	old: number;
	hideFlyers?: boolean;
	heading?: string;
}

const { gridSize, old, hideFlyers = false, heading = "Events" } = Astro.props;
const headingId = `${heading.toLowerCase()}-events-heading`;
const baseUrl = import.meta.env.BASE_URL;

const events = await getCollection("events");
const eventsToUse: typeof events = [];
const eventsSorted = events.toSorted((a, b) => {
	const aDate = a.data.date;
	const bDate = b.data.date;
	return bDate.valueOf() - aDate.valueOf();
});
const now = new Date();
const [eventsAfter, eventsBefore] = eventsSorted.reduce(
	(a, c) => {
		if (
			isEventUpcoming({
				date: c.data.date,
				now,
				timeZone: c.data.timeZone,
			})
		) {
			a[0].push(c);
		} else {
			a[1].push(c);
		}
		return a;
	},
	[[], []] as Array<typeof events>,
);
const numberToGrabFromAfter = gridSize - old;
if (numberToGrabFromAfter > 0) {
	eventsAfter
		.slice(
			eventsAfter.length >= numberToGrabFromAfter
				? numberToGrabFromAfter * -1
				: 0,
		)
		.forEach((event) => {
			eventsToUse.unshift(event);
		});
}
while (
	old > 0 &&
	eventsToUse.length < gridSize &&
	eventsBefore &&
	eventsBefore.length > 0
) {
	const shift = eventsBefore.shift();
	if (shift) {
		eventsToUse.unshift(shift);
	}
}
---

<style>
	.event-container {
		container: events / inline-size;
	}

	.event-grid {
		margin-block-start: 1.25em;
		display: grid;
		gap: 2ch;
		grid-template-columns: 1fr;
		@container events (inline-size > 620px) {
			grid-template-columns: repeat(2, 1fr);
		}
		@container events (inline-size > 960px) {
			grid-template-columns: repeat(3, 1fr);
		}
		@container events (inline-size > 1280px) {
			grid-template-columns: repeat(4, 1fr);
		}
	}

	.event-grid img {
		height: revert;
	}

	.event-grid > a {
		display: block;
		min-inline-size: 0;
		border-block-end: 4px solid var(--secondary-clr);
		text-decoration: none;
	}

	.event-grid > a:focus-visible {
		outline: 2px solid var(--secondary-clr);
		outline-offset: 0.2em;
	}

	.event-details {
		margin-block-start: 0.75em;
		padding-block-end: 1em;
		overflow-wrap: anywhere;
	}

	.event-details h3 {
		font-size: 1em;
		margin-block-start: 0;
	}

	.event-details h3 :global(svg) {
		display: inline-block;
		inline-size: 1em;
		block-size: 1em;
		margin-inline-start: 0.2em;
		vertical-align: -0.125em;
	}

	.event-details p {
		margin-block-start: 0.25em;
	}

	.event-grid > a:hover h3,
	.event-grid > a:focus-visible h3 {
		text-decoration: underline;
		text-decoration-color: var(--secondary-clr);
		text-decoration-thickness: 0.12em;
		text-underline-offset: 0.2em;
	}

	.event-destination {
		display: block;
		margin-block-start: 0.5em;
		text-decoration: underline;
	}

	@container events (inline-size >= 0px) {
		.event-grid--limited a:nth-child(-n + 2),
		.event-grid--limited a:nth-child(n + 6) {
			display: none;
		}
	}

	@container events (inline-size > 620px) {
		.event-grid--limited a:nth-child(6) {
			display: block;
		}
	}

	@container events (inline-size > 960px) {
		.event-grid--limited a:nth-child(2),
		.event-grid--limited a:nth-child(7) {
			display: block;
		}
	}

	@container events (inline-size > 1280px) {
		.event-grid--limited a:nth-child(1),
		.event-grid--limited a:nth-child(8) {
			display: block;
		}
	}

	.event-grid-more {
		margin-block-start: 1.25em;
		text-align: end;
	}
</style>
<section class="grid" aria-labelledby={headingId}>
	<div class="event-container">
		<h2 id={headingId}>{heading}</h2>
		{eventsToUse.length > 0 && (
			<div class:list={["event-grid", { "event-grid--limited": hideFlyers }]}>
				{eventsToUse.map((event, index) => {
					const image =
						index % 2 === 0 ? event.data.images.light : event.data.images.dark;
					const isLikelyFirstVisible = index === (hideFlyers ? 2 : 0);

					return (
						<a href={event.data.url} target="_blank" rel="noopener noreferrer">
							<Image
								src={image.src}
								alt=""
								decoding={isLikelyFirstVisible ? "sync" : "async"}
								fetchpriority={isLikelyFirstVisible ? "high" : "auto"}
								layout="full-width"
								loading={isLikelyFirstVisible ? "eager" : "lazy"}
								quality="low"
								sizes="(min-width: 1281px) 25vw, (min-width: 961px) 33vw, (min-width: 621px) 50vw, 100vw"
								widths={[360, 720]}
							/>
							<div class="event-details">
								<h3 dir="auto">
									{event.data.name}
									<ExternalLink aria-hidden="true" focusable="false" />
								</h3>
								<p>
									<time datetime={event.data.date.toISOString().slice(0, 10)}>
										{formatEventDate({ date: event.data.date })}
									</time>
								</p>
								<p>
									{event.data.startTime ? (
										<time datetime={event.data.startTime}>
											{formatEventTime({
												date: event.data.date,
												startTime: event.data.startTime,
												timeZone: event.data.timeZone,
											})}
										</time>
									) : (
										"Start time on Meetup"
									)}
								</p>
								<p dir="auto">{event.data.location ?? "Location on Meetup"}</p>
								<span class="event-destination">Event details on Meetup</span>
							</div>
						</a>
					);
				})}
			</div>
		)}
		{eventsToUse.length === 0 && (
			<p>No events are listed right now. Check back soon.</p>
		)}
		{hideFlyers && (
			<p class="event-grid-more">
				<a href={`${baseUrl}events/`}>View all events</a>
			</p>
		)}
	</div>
</section>
