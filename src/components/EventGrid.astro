---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

const gridSize = 8;
const old = 2;

const events = await getCollection("events");
const eventsToUse: typeof events = [];
const eventsSorted = events.toSorted((a, b) => {
	const aDate = a.data.date;
	const bDate = b.data.date;
	return bDate.valueOf() - aDate.valueOf();
});
const d = new Date();
const [eventsAfter, eventsBefore] = eventsSorted.reduce(
	(a, c) => {
		if (c.data.date.valueOf() > d.valueOf()) {
			a[0].push(c);
		} else {
			a[1].push(c);
		}
		return a;
	},
	[[], []] as Array<typeof events>,
);
const numberToGrabFromAfter = gridSize - old;
eventsAfter
	.slice(
		eventsAfter.length >= numberToGrabFromAfter
			? numberToGrabFromAfter * -1
			: 0,
	)
	.forEach((event) => {
		eventsToUse.unshift(event);
	});
while (
	eventsToUse.length < gridSize &&
	eventsBefore &&
	eventsBefore.length > 0
) {
	const shift = eventsBefore.shift();
	if (shift) {
		eventsToUse.unshift(shift);
	}
}
---

<style>
	div:has(> .event-grid) {
		container: section / inline-size;
	}

	.event-grid {
		margin-block-start: 1em;
		display: grid;
		gap: 2ch;
		grid-template-columns: 1fr;
		@container (width > 620px) {
			grid-template-columns: repeat(2, 1fr);
		}
		@container (width > 960px) {
			grid-template-columns: repeat(3, 1fr);
		}
		@container (width > 1280px) {
			grid-template-columns: repeat(4, 1fr);
		}
	}

	.event-grid img {
		height: revert;
	}

	.event-grid a:nth-child(-n + 2),
	.event-grid a:nth-child(n + 6) {
		display: none;
	}

	@container (width > 620px) {
		.event-grid a:nth-child(6) {
			display: block;
		}
	}

	@container (width > 960px) {
		.event-grid a:nth-child(2),
		.event-grid a:nth-child(7) {
			display: block;
		}
	}

	@container (width > 1280px) {
		.event-grid a:nth-child(1),
		.event-grid a:nth-child(8) {
			display: block;
		}
	}
</style>
<section class="grid">
	<div>
		{eventsToUse.length > 0 && (
					<div class="event-grid">
						{eventsToUse.map((event, index) => {
							const image =
								index % 2 === 0 ? event.data.images.light : event.data.images.dark;
							const isLikelyFirstVisible = index === 2;

							return (
								<a
									href={event.data.url}
									target="_blank"
									rel="noopener noreferrer"
								>
									<Image
										src={image.src}
										alt={image.alt}
										fetchpriority={isLikelyFirstVisible ? "high" : "auto"}
										layout="full-width"
										loading={isLikelyFirstVisible ? "eager" : "lazy"}
										quality="low"
										sizes="(min-width: 1281px) 25vw, (min-width: 961px) 33vw, (min-width: 621px) 50vw, 100vw"
										widths={[360, 720]}
									/>
								</a>
							);
						})}
					</div>
				)}
		{eventsToUse.length === 0 && (
					<p>No upcoming events are listed right now. Check back soon.</p>
				)}
	</div>
</section>
