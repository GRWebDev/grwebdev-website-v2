---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import {
	formatEventDate,
	formatEventTime,
	isEventUpcoming,
} from "../utils/event-date.ts";

const gridSize = 8;
const old = 2;

const events = await getCollection("events");
const eventsToUse: typeof events = [];
const eventsSorted = events.toSorted((a, b) => {
	const aDate = a.data.date;
	const bDate = b.data.date;
	return bDate.valueOf() - aDate.valueOf();
});
const now = new Date();
const [eventsAfter, eventsBefore] = eventsSorted.reduce(
	(a, c) => {
		if (
			isEventUpcoming({
				date: c.data.date,
				now,
				timeZone: c.data.timeZone,
			})
		) {
			a[0].push(c);
		} else {
			a[1].push(c);
		}
		return a;
	},
	[[], []] as Array<typeof events>,
);
const numberToGrabFromAfter = gridSize - old;
eventsAfter
	.slice(
		eventsAfter.length >= numberToGrabFromAfter
			? numberToGrabFromAfter * -1
			: 0,
	)
	.forEach((event) => {
		eventsToUse.unshift(event);
	});
while (
	eventsToUse.length < gridSize &&
	eventsBefore &&
	eventsBefore.length > 0
) {
	const shift = eventsBefore.shift();
	if (shift) {
		eventsToUse.unshift(shift);
	}
}
---

<style>
	div:has(> .event-grid) {
		container: section / inline-size;
	}

	.event-grid {
		margin-block-start: 1.25em;
		display: grid;
		gap: 2ch;
		grid-template-columns: 1fr;
		@container (width > 620px) {
			grid-template-columns: repeat(2, 1fr);
		}
		@container (width > 960px) {
			grid-template-columns: repeat(3, 1fr);
		}
		@container (width > 1280px) {
			grid-template-columns: repeat(4, 1fr);
		}
	}

	.event-grid img {
		height: auto;
	}

	.event-grid article:nth-child(-n + 2),
	.event-grid article:nth-child(n + 6) {
		display: none;
	}

	@container (width > 620px) {
		.event-grid article:nth-child(6) {
			display: block;
		}
	}

	@container (width > 960px) {
		.event-grid article:nth-child(2),
		.event-grid article:nth-child(7) {
			display: block;
		}
	}

	@container (width > 1280px) {
		.event-grid article:nth-child(1),
		.event-grid article:nth-child(8) {
			display: block;
		}
	}

	.event-grid article {
		border-block-end: 4px solid var(--secondary-clr);
	}

	.event-grid a {
		display: block;
		text-decoration: none;
	}

	.event-caption {
		padding-block: 0.75rem 1rem;
	}

	.event-caption h3,
	.event-caption p {
		margin-block-start: 0;
	}

	.event-caption h3 {
		font-size: 1.125rem;
		line-height: 1.25;
	}

	.event-caption p {
		font-size: 0.875em;
		line-height: 1.4;
	}

	.event-caption .address {
		color: var(--gray-300);
	}

	.event-grid a:hover h3,
	.event-grid a:focus-visible h3 {
		text-decoration: underline;
		text-decoration-color: var(--secondary-clr);
		text-decoration-thickness: 0.12em;
		text-underline-offset: 0.2em;
	}
</style>
<section class="grid" aria-labelledby="community-calendar-heading">
	<div>
		<h2 id="community-calendar-heading">Events</h2>
		{eventsToUse.length > 0 && (
			<div class="event-grid">
				{eventsToUse.map((event, index) => {
					const image =
						index % 2 === 0 ? event.data.images.light : event.data.images.dark;
					const isLikelyFirstVisible = index === 2;
					return (
						<article>
							<a
								href={event.data.url}
								target="_blank"
								rel="noopener noreferrer"
							>
								<Image
									src={image.src}
									alt=""
									decoding={isLikelyFirstVisible ? "sync" : "async"}
									fetchpriority={isLikelyFirstVisible ? "high" : "auto"}
									layout="full-width"
									loading={isLikelyFirstVisible ? "eager" : "lazy"}
									quality="low"
									sizes="(min-width: 1281px) 25vw, (min-width: 961px) 33vw, (min-width: 621px) 50vw, 100vw"
									widths={[360, 720]}
								/>
								<div class="event-caption">
									<h3>{event.data.name}</h3>
									<p>
										<time datetime={event.data.startDateTime}>
											{formatEventDate({ date: event.data.date })} · {formatEventTime({
												startDateTime: event.data.startDateTime,
												timeZone: event.data.timeZone,
											})}
										</time>
									</p>
									<p>{event.data.locationName}</p>
									{event.data.locationAddress && (
										<p class="address">{event.data.locationAddress}</p>
									)}
								</div>
							</a>
						</article>
					);
				})}
			</div>
		)}
		{eventsToUse.length === 0 && (
			<p>No events are listed right now. Check back soon.</p>
		)}
	</div>
</section>
