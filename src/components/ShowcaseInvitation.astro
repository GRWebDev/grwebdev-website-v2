---
import ExternalLink from "../assets/icons/square-arrow-out-up-right.svg";

interface Props {
	headingId: string;
	showSubmittedAction?: boolean;
}
const { headingId, showSubmittedAction = false } = Astro.props;
---

<div class="showcase-copy">
	<h2 id={headingId}>Community Code Showcase on Monday, November 23</h2>
	<p>
		Have a project, tool, or development discovery to share? Share at GRWebDev's
		Community Code Showcase. Demos and talks can be up to 10 minutes. No slide
		deck required.
	</p>
	<p class="deadline">Submit your idea by Friday, November 13.</p>
	<div class="actions">
		<a
			href="https://forms.gle/2GJXyVBTEgTXV2uy5"
			class="action primary"
			target="_blank"
			rel="noopener noreferrer"
			aria-label="Submit your idea (opens in a new tab)"
		>
			Submit your idea <ExternalLink aria-hidden="true" focusable="false" />
		</a>
		<button
			class="action submitted"
			type="button"
			hidden={!showSubmittedAction}
		>
			I've already submitted
		</button>
	</div>
</div>

<style>
	.showcase-copy {
		max-inline-size: 65ch;
	}
	h2 {
		margin-block-start: 0;
		font-size: clamp(1.5rem, 3vw, 2.5rem);
		line-height: 1.2;
	}
	.deadline {
		font-weight: 650;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		align-items: stretch;
		gap: 0.75rem;
		margin-block-start: 1.25em;
	}
	.action:not([hidden]) {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		min-block-size: 56px;
		padding: 0.75rem 1rem;
		border: 2px solid var(--primary-clr);
		border-radius: 0;
		font: inherit;
		font-weight: 700;
		line-height: 1.5;
		text-decoration: none;
		cursor: pointer;
	}
	.action.primary {
		background: var(--secondary-clr);
		border-color: var(--secondary-clr);
		color: var(--tertiary-clr);
	}
	.action.submitted {
		background: var(--tertiary-clr);
		color: var(--primary-clr);
	}
	.action:hover,
	.action:focus-visible {
		text-decoration: underline;
		text-decoration-thickness: 0.12em;
		text-underline-offset: 0.24em;
	}
	.action:focus-visible {
		outline: 2px solid var(--primary-clr);
		outline-offset: 4px;
	}
	.action.primary:active {
		background: var(--primary-clr);
		border-color: var(--primary-clr);
	}
	.action.submitted:hover,
	.action.submitted:active {
		background: var(--primary-clr);
		color: var(--tertiary-clr);
	}

	.action.primary :global(svg) {
		inline-size: 1.125rem;
		block-size: 1.125rem;
		flex: none;
	}
</style>
