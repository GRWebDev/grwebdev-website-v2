---
import Logo from "../assets/grwebdev.svg";

const isActivePath = (path: string) => Astro.url.pathname.includes(path);
---

<header>
	<nav class="grid" aria-label="Primary navigation">
		<ul class="outdent">
			<li>
				<a href={import.meta.env.BASE_URL} aria-label="Home">
					<Logo />
				</a>
			</li>
			<li>
				<a
					aria-current={isActivePath("board") ? "page" : undefined}
					class={isActivePath("board") ? "active" : ""}
					href={`${import.meta.env.BASE_URL}board`}
					>Board</a
				>
			</li>
			<li>
				<a
					aria-current={isActivePath("sponsors") ? "page" : undefined}
					class={isActivePath("sponsors") ? "active" : ""}
					href={`${import.meta.env.BASE_URL}sponsors`}
					>Sponsors</a
				>
			</li>
			<li>
				<a
					aria-current={isActivePath("about") ? "page" : undefined}
					class={isActivePath("about") ? "active" : ""}
					href={`${import.meta.env.BASE_URL}about`}
					>About</a
				>
			</li>
		</ul>
	</nav>
</header>
