---
import Logo from "../assets/grwebdev.svg";
import Menu from "../assets/menu-bars.svg";
import { withBase } from "../utils/utils.ts";

interface Props {
	headerText: string;
}

const { headerText } = Astro.props;
console.log({ headerText });
---

<style>
	h1 {
		margin: 0;
		font-size: clamp(1.1112em, 2.5cqi - 0.175em, 2em);
	}
</style>
<header>
	<nav class="grid">
		<ul id="site-menu">
			<li class="collapsed">
				<label
					for="show-menu"
					aria-label="Expand / Collapse Navigation"
					aria-controls="site-menu"
					><Logo class="logo" />
					<Menu />
					<input type="checkbox" id="show-menu" name="show-menu">
				</label>
			</li>
			<li class="expanded">
				<a href={withBase(`/`)} aria-label="Home"> <Logo /> </a>
			</li>
			<li class="expanded grow"><h1>{headerText}</h1></li>
			<!-- TODO: Add What we do and get involved links/pages -->
			<li class="collapsed"><a href={withBase(`/`)}>Home</a></li>
			<li><a href={withBase(`/board`)}>Board</a></li>
			<li class="spacer"><a href={withBase(`/sponsors`)}>Sponsors</a></li>
			<li class="spacer"><a href={withBase(`/about`)}>About</a></li>
		</ul>
	</nav>
</header>
