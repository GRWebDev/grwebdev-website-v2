{
	"name": "gr_web_dev",
	"type": "module",
	"version": "0.0.1",
	"engines": {
		"node": ">=22.22.1",
		"npm": ">=9.6.5"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"test": "node --test test/*.test.ts && npm run typecheck && npm run lint && npm run build",
		"typecheck": "astro check",
		"update:events": "node scripts/update-events.ts",
		"lint": "biome check",
		"lint:fix": "biome check --write .",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{astro,css,mjs,ts}": "biome check --write --no-errors-on-unmatched"
	},
	"dependencies": {
		"@fontsource-variable/open-sans": "^5.3.0",
		"astro": "^7.2.4"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.9",
		"@biomejs/biome": "2.5.10",
		"@types/node": "^22.20.1",
		"husky": "^9.1.7",
		"lint-staged": "17.3.0",
		"playwright": "^1.62.1",
		"typescript": "^6.0.3"
	}
}
